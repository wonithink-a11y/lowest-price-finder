# Postgres. 로컬: `npm run db:up` (docker-compose) 후 아래 값 그대로 사용.
# 클라우드(Neon 등): DATABASE_URL = 풀러(pooled) URL, DIRECT_URL = 직결(direct) URL.
#   Neon 풀러 URL에는 `?pgbouncer=true&connect_timeout=15` 를 붙인다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/price_finder"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/price_finder"

# LLM (5장 정규화/그룹핑 호출에 필수)
ANTHROPIC_API_KEY=
# 선택: 모델 오버라이드 (기본값은 src/lib/llm/client.ts)
# NORMALIZE_MODEL=claude-sonnet-4-6
# GROUPING_MODEL=claude-haiku-4-5

# 네이버 쇼핑 검색 API - https://developers.naver.com/apps 에서 발급 (1단계 핵심 소스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡 파트너스 API - 제휴 승인 후 발급 (7장). 미설정 시 쿠팡 소스만 건너뛰고 나머지는 정상 동작.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 알리익스프레스 Affiliate Open Platform - 신분증 제출 후 승인 2~3일 (7장). 미설정 시 건너뜀.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# 선택: 사이트 접근 비밀번호. 로그인 화면에서 한 번 입력하면 기기별로 180일 유지. 공개 URL에서 LLM 비용 남용 방지용.
APP_PASSWORD=
