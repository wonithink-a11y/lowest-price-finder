// 명세서 9장 DB 스키마 1:1 매핑.
// 클라우드(서버리스) 배포 기준 Postgres. 로컬은 docker-compose.yml의 Postgres 사용.
// DATABASE_URL: 런타임 쿼리용(풀러 가능), DIRECT_URL: 마이그레이션용 직결 URL.
generator client {
  provider = "prisma-client-js"
  // native: 로컬/CI, rhel-openssl-3.0.x: Vercel·AWS Lambda(Amazon Linux 2023), debian: Docker(node:20-slim)
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Reference 캐시. TTL 30일 — expiresAt 기준으로 앱 코드에서 재검증.
model CanonicalProduct {
  id           String   @id @default(cuid())
  brand        String
  productName  String
  strengthCfu  String // Reference 원본 스케일 값을 문자열로 저장 (types.ts Reference.strength_cfu 주석 참고)
  strengthUnit String // 억CFU | Billion | 조CFU | IU | mg (types.ts Reference.strength_unit 참고)
  strengthType String // guaranteed | input | unknown
  category     String // probiotics | vitamin | omega3 | general
  aliases      String // JSON.stringify(string[])
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  normalized OfferNormalized[]

  @@index([brand, productName])
}

// 원본 응답 영구 보존. 프롬프트 개선 시 리플레이 대상 (수정 금지, append-only로 취급).
model OfferRaw {
  id          String   @id @default(cuid())
  collectedAt DateTime @default(now())
  query       String
  source      String // naver | coupang | aliexpress | cj_themarket
  payload     String // JSON.stringify(RawOffer)

  normalized OfferNormalized[]

  @@index([query, source])
}

// LLM verdict 결과. prompt_version 필수 — 이게 없으면 개선 여부를 측정할 방법이 없음.
model OfferNormalized {
  id            String            @id @default(cuid())
  rawId         String
  raw           OfferRaw          @relation(fields: [rawId], references: [id])
  canonicalId   String?
  canonical     CanonicalProduct? @relation(fields: [canonicalId], references: [id])
  promptVersion String
  model         String
  verdict       String // JSON.stringify(Verdict)
  createdAt     DateTime          @default(now())

  final       OfferFinal?
  reviewQueue ReviewQueue?

  @@index([rawId])
}

// 계산 완료 후 최종 노출 대상. 게이트 통과 건만 존재.
model OfferFinal {
  id                   String          @id @default(cuid())
  normalizedId         String          @unique
  normalized           OfferNormalized @relation(fields: [normalizedId], references: [id])
  country              String // KR | GLOBAL
  rank                 Int
  source               String
  mall                 String
  seller               String
  title                String
  url                  String
  image                String?
  isParallelImport     Boolean
  formulationDiffers   Boolean
  brand                String
  productName          String
  strength             String // 표시용, 예: "500억 CFU"
  variant              String // 표시용, 예: "30포 x 2박스"
  totalUnits           Int
  price                Int
  shippingFee          Int
  totalCost            Int
  unitPrice            Float
  shippingDays         Int?
  customsNote          String?
  matchScore           Int
  extractionConfidence Float
  needsReview          Boolean
  flags                String // JSON.stringify(string[])
  collectedAt          DateTime

  @@index([country, rank])
}

// 게이트 탈락 건. 수동 검토용.
model ReviewQueue {
  id           String          @id @default(cuid())
  normalizedId String          @unique
  normalized   OfferNormalized @relation(fields: [normalizedId], references: [id])
  reason       String
  createdAt    DateTime        @default(now())
}

// CJ더마켓 크롤링 결과 캐시. 서버리스는 파일시스템에 쓸 수 없으므로 JSON 파일 대신 DB에 둔다.
// scripts/crawl-cj-themarket.ts(GitHub Actions)가 쓰고, src/lib/sources/cjthemarket.ts가 읽는다.
model CjThemarketCache {
  query     String   @id
  crawledAt DateTime
  offers    String // JSON.stringify(RawOffer[])
}
